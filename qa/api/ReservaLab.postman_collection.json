{
  "info": {
    "name": "ReservaLab - API y flujo completo",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "24 solicitudes. Ejecutar en una base QA aislada con datos demo. No ejecutar en PROD."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:3001"
    },
    {
      "key": "adminEmail",
      "value": "admin@reservalab.test"
    },
    {
      "key": "adminPassword",
      "value": "AdminDemo2026!"
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if(!pm.collectionVariables.get(\"runId\")){ const start=Math.ceil(Date.now()/60000)*60000+5*60000;pm.collectionVariables.set(\"runId\",String(Date.now()));pm.collectionVariables.set(\"start\",start);pm.collectionVariables.set(\"end\",start+3600000);pm.collectionVariables.set(\"invalidEnd\",start+59*60000); }"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "API-01 Salud",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/health"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\",()=>pm.response.to.have.status(200));",
              "const body=pm.response.json();",
              "pm.test(\"Esquema JSON\",()=>pm.response.to.have.jsonSchema({\"type\": \"object\", \"required\": [\"status\"]}));",
              "pm.test(\"Servicio disponible\",()=>pm.expect(body.status).to.equal(\"ok\"));",
              "pm.test(\"Contenido no vacío\",()=>pm.expect(body).to.not.equal(null));"
            ]
          }
        }
      ]
    },
    {
      "name": "API-02 Sin sesión",
      "request": {
        "method": "GET",
        "header": [],
