        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 401\",()=>pm.response.to.have.status(401));",
              "const body=pm.response.json();",
              "pm.test(\"Esquema JSON\",()=>pm.response.to.have.jsonSchema({\"type\": \"object\", \"required\": [\"code\", \"message\"]}));",
              "pm.test(\"Contenido de error\",()=>pm.expect(body.message).to.be.a(\"string\").and.not.empty);"
            ]
          }
        }
      ]
    },
